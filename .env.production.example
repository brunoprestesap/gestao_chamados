# === Severino — Variáveis de Ambiente (Docker / Produção) ===
# Copie para .env e preencha com os valores reais.
# Gere secrets com: openssl rand -base64 32

# Segredo do NextAuth
AUTH_SECRET=

# Segredo compartilhado Next.js <-> socket-server
SOCKET_INTERNAL_SECRET=

# URL pública da aplicação (domínio da VPS, como o browser acessa)
AUTH_URL=http://sigma.ap.trf1.gov.br
NEXT_PUBLIC_SOCKET_URL=http://sigma.ap.trf1.gov.br
SOCKET_CORS_ORIGIN=http://sigma.ap.trf1.gov.br

# Porta exposta pelo Nginx (padrão: 80)
APP_PORT=80

# MongoDB (opcional — só necessário para habilitar autenticação no banco)
# Sem MONGODB_URI, o next-app conecta sem credenciais em mongodb://mongodb:27017/manutencao.
# Para ligar --auth no Mongo, siga scripts/mongo-enable-auth.md antes de definir esta variável.
# MONGODB_URI=mongodb://sigma_app:senha-gerada@mongodb:27017/manutencao?authSource=admin

# Cookie seguro (use true apenas com HTTPS)
AUTH_COOKIE_SECURE=false

# LDAP / Active Directory (opcional)
# Se LDAP_URL não estiver definido, apenas autenticação local será usada.
# LDAP_URL=ldaps://ad.empresa.com:636
# LDAP_BASE_DN=DC=empresa,DC=com
# LDAP_BIND_DN=CN=svc-sigma,OU=ServiceAccounts,DC=empresa,DC=com
# LDAP_BIND_PASSWORD=senha-da-conta-de-servico
# LDAP_USER_SEARCH_FILTER=(sAMAccountName={{username}})
# LDAP_TLS_REJECT_UNAUTHORIZED=true
# LDAP_DEBUG=false

# IA local — vLLM com Qwen3 na rede interna (opcional, spec 0001)
# Sem LLM_BASE_URL, LLM_API_KEY ou LLM_MODEL a IA fica desligada e o app segue sem ela.
# Só o servidor lê estas variáveis; nunca crie NEXT_PUBLIC_LLM_*.
# LLM_BASE_URL=http://host-do-vllm:8000/v1
# LLM_API_KEY=chave-emitida-pela-equipe-da-gpu
# LLM_MODEL=qwen3-8b
# LLM_ENABLED=true            # false desliga a IA sem apagar as outras variáveis
# LLM_MAX_CONCURRENCY=4       # chamadas simultâneas combinadas com a equipe da GPU (1 a 16)
# LLM_DEBUG=false             # true loga o texto enviado e recebido; só para diagnóstico (LGPD)
